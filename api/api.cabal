cabal-version:      3.0
name:               api
version:            0.1.0.0
license:            GPL-3.0-only
license-file:       LICENSE
author:             Bruno Panizzi
maintainer:         brunopanizziq@gmail.com
category:           Web
build-type:         Simple

extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable api
    import:           warnings
    main-is:          Main.hs

    build-depends:    base ^>=4.18.3.0,
                      servant,
                      text,
                      servant-server,
                      wai,
                      warp,
                      pandoc-server,
                      aeson,
                      postgresql-simple,
                      uuid,
                      uuid-types,
                      bcrypt,
                      bytestring
    
    other-modules:    Models

    hs-source-dirs:   src

    default-language: Haskell2010
